      "target": {
        "frames": [
          "workbench"
        ],
        "kind": "row_value",
        "name": "Review status",
        "role": null
      },
      "operations": [
        "read"
      ],
      "risk": "reversible",
      "description": "Review status",
      "allowed_output_values": [
        "Ready for confirmation"
      ]
    },
    "review_nickname": {
      "target": {
        "kind": "row_value",
        "frames": [
          "workbench"
        ],
        "name": "Nickname"
      },
      "description": "Nickname displayed on the sub-account review"
    }
  },
  "states": {
    "member_not_found": {
      "target": "not_found",
      "kind": "business"
    },
    "validation_error": {
      "target": "validation",
      "kind": "business"
    },
    "permission_denied": {
      "target": "denied",
      "kind": "business"
    },
    "session_expired": {
      "target": "expired",
      "kind": "human",
      "manual_recovery": "renew_session"
    },
    "supervisor_review": {
      "target": "review_dialog",
      "kind": "human",
      "manual_recovery": "acknowledge"
    },
    "service_notice": {
      "target": "notice",
      "kind": "interstitial",
      "recovery": "dismiss_notice"
    },
    "loading_accounts": {
      "target": "loading",
      "kind": "transient"
    },
    "service_unavailable": {
      "target": "unavailable",
      "kind": "failure"
    }
  },
  "input_types": {
    "member_id": {
      "kind": "identifier",
      "pattern": "[0-9]{5}"
    },
    "nickname": {
      "kind": "text",
      "max_length": 40
    }
  },
  "invariants": [
    {
      "target": "member_identity",
      "kind": "equals_input",
      "input": "member_id"
    },
    {
      "target": "review_nickname",
      "kind": "equals_input",
      "input": "nickname"
    }
  ],
  "live_mode": "forms",
  "live_scopes": [
    {
      "name": "lookup",
      "container": "form[action=\"/desk/search\"]",
      "action": "/desk/search",
      "frames": [
        "workbench"
      ],
      "methods": [
        "POST"
      ],
      "operations": [
        "click",
        "fill"
      ],
      "fields": {
        "member_key": [
          "member_id"
        ]
      },
      "static_text": true,
      "excluded": [
        "[data-private]",
        "[data-sensitive]"
      ]
    },
    {
      "name": "member",
      "container": "form[action=\"/desk/member\"]",
